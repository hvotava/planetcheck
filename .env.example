# ---------------------------------------------------------------------------
# planetcheck — environment. Copy to .env.local. Never commit real values.
# ---------------------------------------------------------------------------

# Data backend: "pg" (Railway Postgres, production) or "pglite" (embedded Postgres for local dev/tests).
# Defaults to pg when DATABASE_URL is set, otherwise pglite.
PLANETCHECK_DATA=pglite
PGLITE_DIR=.pglite/dev

# Railway Postgres (server-only). Use the private URL inside Railway, the public one for local access.
DATABASE_URL=
# Set to "require" when connecting through Railway's public TCP proxy.
PGSSLMODE=

# Railway Redis for rate limiting (optional; leave empty → in-memory limiter).
REDIS_URL=

# Cloudflare Turnstile — these are Cloudflare's official test keys (always pass)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secrets. IP_SALT rotates quarterly (never daily — it would break in-round dedupe).
IP_SALT=change-me-32-random-bytes
CRON_SECRET=change-me
ADMIN_TOKEN=change-me
# Signs the verified-session cookie and hashes OAuth subject ids (never stored raw).
AUTH_SECRET=change-me-32-random-bytes

# Verified layer — OAuth (Google, Apple). Optional; without them /verify is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Claude API (narrator + translations)
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-sonnet-5
TRANSLATE_MODEL=claude-haiku-4-5-20251001

# Internal scheduler (recompute every 10 min, narrator daily). Uses a Postgres advisory lock,
# so multiple replicas are safe. Set to "false" if you drive /api/cron/* from Railway cron instead.
PLANETCHECK_INTERNAL_CRON=true

# Public site URL (OG images, share links, OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter (termíny dalších kol). Without a sender the signup form is not shown at all:
# double opt-in needs a confirmation mail, and collecting addresses we cannot confirm
# would be both useless and unlawful.
RESEND_API_KEY=
NEWSLETTER_FROM="Přežijeme? <kola@example.org>"
# Local development: print the confirmation mail to the console instead of sending it.
NEWSLETTER_DEV_LOG=false
